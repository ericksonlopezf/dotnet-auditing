<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>Core audit pipeline for EricksonLopez.Auditing: AuditScope, AuditConfiguration, HMAC integrity, sensitivity pipeline, and DI extensions. AOT-compatible. Requires an IAuditStore adapter (e.g., EricksonLopez.Auditing.PostgreSql).</Description>
    <PackageTags>$(CommonPackageTags);audit-scope;pii-protection;data-masking;hmac;integrity;tamper-evident;native-aot;multi-tenant</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Auditing.Abstractions\EricksonLopez.Auditing.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
