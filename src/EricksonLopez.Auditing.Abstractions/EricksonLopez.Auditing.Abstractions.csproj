<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>Foundation contracts and primitives for audit trails in .NET 8+. Zero external runtime dependencies. AOT-compatible.</Description>
    <PackageTags>$(CommonPackageTags);abstractions;contracts;interfaces;audit-record;native-aot;uuidv7;multi-tenant;hmac</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
