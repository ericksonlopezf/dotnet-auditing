<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>ASP.NET Core Minimal API endpoint mapping extensions for EricksonLopez.Mediator.</Description>
    <PackageTags>$(CommonPackageTags);aspnetcore;minimal-apis;endpoints;webapi;routing</PackageTags>
    <NoWarn>$(NoWarn);IL3050;IL2026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Mediator\EricksonLopez.Mediator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Mediator.IntegrationTests" />
    <InternalsVisibleTo Include="EricksonLopez.Mediator.AspNetCore.Tests" />
  </ItemGroup>

</Project>
