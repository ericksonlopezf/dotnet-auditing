<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>PostgreSQL + Dapper adapter for EricksonLopez.Auditing. Includes append-only store, RLS tenant isolation, keyset pagination, monthly partitioning, and HMAC chain integrity. AOT-compatible.</Description>
    <PackageTags>$(CommonPackageTags);postgresql;postgres;npgsql;dapper;rls;row-level-security;multi-tenant;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Auditing.Abstractions\EricksonLopez.Auditing.Abstractions.csproj" />
  </ItemGroup>

</Project>
