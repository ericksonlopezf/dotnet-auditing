<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>Oracle Database adapter for EricksonLopez.Auditing. Supports Oracle 19c, 21c, and 23ai with Dapper and Oracle.ManagedDataAccess.Core. AOT-compatible.</Description>
    <PackageTags>$(CommonPackageTags);oracle;oracle-database;vpd;virtual-private-database;dapper;multi-tenant;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Auditing.Abstractions\EricksonLopez.Auditing.Abstractions.csproj" />
  </ItemGroup>

</Project>
