<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <Description>Azure Key Vault cryptographic integrity provider for EricksonLopez.Auditing. Enables dynamic HMAC audit key rotation and secure per-tenant key management.</Description>
    <PackageTags>$(CommonPackageTags);azure;azure-key-vault;key-vault;key-rotation;kms;cryptography</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Auditing.Abstractions\EricksonLopez.Auditing.Abstractions.csproj" />
  </ItemGroup>

</Project>
