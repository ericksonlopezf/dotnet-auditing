<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'EricksonLopez.Mediator.Generator'">
    <IncludeSymbols>false</IncludeSymbols>
    <!-- Source generators are compile-time-only tools.
         Exclude them from Sonar CPD: their code is template-driven and
         structurally similar across generators by design, not by negligence. -->
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>
</Project>
